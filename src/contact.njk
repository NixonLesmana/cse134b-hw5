<section id="contact-form">
    <h2>Send a Message</h2>

    <form action="#" method="post">
        <fieldset>
            <legend>Contact Form</legend>

            <p>
                <label for="name">Name</label><br>
                <input type="text" id="name" name="name" required minlength="2" maxlength="80" autocomplete="name">
            </p>

            <p>
                <label for="email">Email</label><br>
                <input type="email" id="email" name="email" required autocomplete="email">
            </p>

            <p>
                <label for="reason">Reason for reaching out</label><br>
                <input type="text" id="reason" name="reason" required minlength="4" maxlength="120">
            </p>

            <p>
                <label for="message">Message</label><br>
                <textarea id="message" name="message" rows="6" cols="40" required minlength="20" maxlength="1200"></textarea>
            </p>

            <button type="submit">Send Message</button>
        </fieldset>
    </form>

    <p>
        This form uses built-in browser validation. It is included as a portfolio contact mockup until I connect a real form endpoint.
    </p>
</section>

